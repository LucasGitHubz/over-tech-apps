---
import { availableGuides } from "../../../lib/solemate-guides";
import { apps } from "../../../data/apps";

export function getStaticPaths() {
  return availableGuides().map((guide) => ({
    params: { slug: guide.frontmatter.slug },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content, frontmatter } = guide;
const app = apps.find((item) => item.slug === "solemate-run")!;
const canonical = `https://over-tech-apps.pages.dev/solemate-run/guides/${frontmatter.slug}/`;
const date = new Date(frontmatter.date_proposee + "T12:00:00Z");
const isPreview = frontmatter.date_proposee > new Date().toISOString().slice(0, 10);
const provider = import.meta.env.PUBLIC_SOLEMATE_APPLE_PROVIDER_TOKEN || "";
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{frontmatter.title} | SoleMate Run</title>
    <meta name="description" content={frontmatter.description} />
    <meta name="theme-color" content="#080b08" />
    {isPreview && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={frontmatter.title} />
    <meta property="og:description" content={frontmatter.description} />
    <meta property="og:url" content={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <nav aria-label="Navigation principale">
      <a class="brand" href="/solemate-run/">SOLEMATE <span>RUN</span></a>
      <a href="/solemate-run/#guides">Tous les guides</a>
    </nav>
    <main>
      <header>
        <p class="eyebrow">CHOISIR SES CHAUSSURES</p>
        <h1>{frontmatter.title}</h1>
        <p class="byline">{isPreview ? "Aperçu · Publication prévue le " : "Publié le "}
          <time datetime={frontmatter.date_proposee}>{date.toLocaleDateString("fr-FR", {day:"numeric",month:"long",year:"numeric"})}</time>
          {" · Over Tech Apps"}
        </p>
      </header>
      <article><Content /></article>
      <aside aria-label="Découvrir SoleMate Run">
        <div>
          <p class="eyebrow">VOTRE PROCHAINE PAIRE</p>
          <h2>Comparez une sélection adaptée à votre profil.</h2>
          <p>Répondez au questionnaire de SoleMate. Téléchargement gratuit sur iOS et Android.</p>
          <div class="downloads">
            <a class="button" data-solemate-store="ios" data-apple-provider={provider} href={app.appStoreUrl}>App Store</a>
            <a class="button secondary" data-solemate-store="android" href={app.playStoreUrl}>Google Play</a>
          </div>
        </div>
        <img src="/apps/solemate-run/results.png" alt="Exemple de recommandations de chaussures dans SoleMate Run" loading="lazy" width="158" height="343" />
      </aside>
    </main>
    <footer><a href="/solemate-run/">SoleMate Run</a><a href="/apps/solemate-run/affiliation/">Affiliation et transparence</a><a href="mailto:overtechapps@gmail.com">Contact</a></footer>
    <script>import "../../../scripts/solemate-campaign-links";</script>
  </body>
</html>
<style>
  :global(*){box-sizing:border-box}
  :global(body){margin:0;background:#080b08;color:#eef2e9;font-family:"DM Sans",sans-serif;font-size:18px;line-height:1.75}
  nav,footer{width:min(1040px,calc(100% - 40px));margin:auto;display:flex;justify-content:space-between;gap:20px;align-items:center;padding:28px 0}
  nav{border-bottom:1px solid #263023}
  a{color:#d9f942;text-underline-offset:4px}
  nav a,footer a{font-size:15px}
  .brand{font-family:"Manrope",sans-serif;font-weight:800;text-decoration:none;letter-spacing:-.04em;font-size:21px;color:#eef2e9}
  .brand span{color:#d9f942}
  main{width:min(760px,calc(100% - 40px));margin:68px auto}
  .eyebrow{color:#d9f942;font-size:13px;letter-spacing:.13em;font-weight:700}
  h1,h2{font-family:"Manrope",sans-serif;line-height:1.15}
  h1{font-size:clamp(32px,5vw,49px);letter-spacing:-.045em;margin:17px 0 23px}
  .byline{font-size:14px;color:#aeb9a6;margin-bottom:46px}
  :global(article h2){font-family:"Manrope",sans-serif;font-size:27px;line-height:1.3;letter-spacing:-.025em;margin:46px 0 17px}
  :global(article p),:global(article li){color:#d2dacb}
  :global(article a){color:#d9f942;overflow-wrap:anywhere;text-underline-offset:4px}
  :global(article li){margin-bottom:10px}
  :global(article strong){color:#f3f6ef}
  :global(article blockquote){border-left:3px solid #d9f942;margin-left:0;padding-left:22px}
  aside{margin-top:54px;border:1px solid #334126;border-radius:20px;background:#121a0d;padding:28px;display:grid;grid-template-columns:1fr 132px;gap:24px;align-items:center}
  aside h2{font-size:26px;margin:12px 0}
  aside p{font-size:16px;color:#c4cfbb}
  aside .eyebrow{color:#d9f942;font-size:12px}
  aside img{width:132px;height:auto;border-radius:14px}
  .downloads{display:flex;flex-wrap:wrap;gap:10px;margin-top:24px}
  .button{background:#d9f942;color:#111807;padding:11px 16px;border-radius:9px;text-decoration:none;font-size:15px;font-weight:700}
  .secondary{background:transparent;border:1px solid #819446;color:#eef2e9}
  footer{border-top:1px solid #263023;flex-wrap:wrap}
  a:focus-visible{outline:3px solid #d9f942;outline-offset:5px}
  @media(max-width:540px){main{margin-top:42px}nav{align-items:flex-start}nav a{font-size:14px}.brand{font-size:18px}aside{grid-template-columns:1fr;padding:22px}aside img{display:none}:global(article h2){font-size:24px}}
</style>
