---
import { apps } from "../data/apps";

const featuredSlug = "solemate-run";
const shownBrands = ["ASICS", "HOKA", "Nike", "Brooks", "Salomon", "On"];
const homeApps = [
  ...apps.filter((app) => app.slug === featuredSlug),
  ...apps.filter((app) => app.slug !== featuredSlug),
];
const year = new Date().getFullYear();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Over Tech Apps</title>
    <meta
      name="description"
      content="Official website for Over Tech Apps. Discover apps, privacy policies, support pages, and terms."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <div class="scene">
      <div class="grid-layer" aria-hidden="true"></div>
      <div class="glows" aria-hidden="true">
        <div class="glow glow-sky"></div>
        <div class="glow glow-indigo"></div>
      </div>

      <main class="page">
        <nav class="nav">
          <a class="brand" href="/">
            <span class="logo">OT</span>
            <span class="wordmark">Over Tech Apps</span>
          </a>
          <div class="nav-links">
            <a class="nav-apps" href="#apps">Apps</a>
            <a class="nav-contact" href="mailto:overtechapps@gmail.com">Contact</a>
          </div>
        </nav>

        <header class="hero">
          <p class="eyebrow"><span class="dot"></span>Over Tech Apps</p>
          <h1>Useful apps, built with <span class="gradient-text">care and clarity</span>.</h1>
          <p class="subtitle">
            The official home for apps published by Over Tech Apps — with simple
            support pages, honest privacy policies, and clear terms.
          </p>
          <div class="ctas">
            <a class="cta-primary" href="#apps">Discover the apps <span class="arrow">→</span></a>
            <a class="cta-ghost" href="mailto:overtechapps@gmail.com">Get in touch</a>
          </div>
        </header>

        <section id="apps" class="apps">
          <div class="section-header">
            <h2>Apps</h2>
            <p>Published on the App Store</p>
          </div>

          {homeApps.map((app) => (
            <a
              class="featured"
              href={`/apps/${app.slug}`}
              style={`--accent-from: ${app.accent.from}; --accent-to: ${app.accent.to}; --accent-rgb: ${app.accent.rgb};`}
            >
              <div class="featured-copy">
                <div class="featured-meta">
                  {app.slug === featuredSlug && <span class="pill-featured">Featured</span>}
                  <span class="platform">iOS · {app.category}</span>
                </div>
                <h3>{app.name}</h3>
                <p class="featured-description">{app.description}</p>
                {app.affiliate?.enabled && (
                  <div class="chips">
                    {shownBrands.map((brand) => <span class="chip">{brand}</span>)}
                    <span class="chip-more">+{app.affiliate.brands.length - shownBrands.length} more</span>
                  </div>
                )}
                <span class="featured-link">View app <span class="arrow">→</span></span>
              </div>
              <div class="featured-visual">
                <img
                  src={app.screenshots[0].src}
                  alt={`${app.name} — ${app.screenshots[0].title}`}
                />
              </div>
            </a>
          ))}

          <div class="placeholder">More apps coming soon</div>
        </section>

        <footer>
          <p>© {year} Over Tech Apps</p>
          <div class="footer-links">
            <a href="mailto:overtechapps@gmail.com">overtechapps@gmail.com</a>
            <a href="/mentions-legales">Mentions légales</a>
          </div>
        </footer>
      </main>
    </div>
  </body>
</html>

<style>
  :global(html),
  :global(body) {
    margin: 0;
    padding: 0;
    background: #05080f;
  }

  :global(body) {
    font-family: "Instrument Sans", ui-sans-serif, system-ui, sans-serif;
    color: #e2e8f0;
    -webkit-font-smoothing: antialiased;
  }

  :global(::selection) {
    background: rgba(56, 189, 248, 0.35);
  }

  a {
    text-decoration: none;
  }

  .scene {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
  }

  .grid-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(148, 163, 184, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(148, 163, 184, 0.05) 1px, transparent 1px);
    background-size: 72px 72px;
    -webkit-mask-image: radial-gradient(ellipse 90% 60% at 50% 0%, black 30%, transparent 75%);
    mask-image: radial-gradient(ellipse 90% 60% at 50% 0%, black 30%, transparent 75%);
  }

  .glows {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .glow {
    position: absolute;
    border-radius: 50%;
  }

  .glow-sky {
    top: -220px;
    left: -140px;
    width: 640px;
    height: 640px;
    background: radial-gradient(circle, rgba(56, 189, 248, 0.22), transparent 65%);
    filter: blur(40px);
    animation: drift 14s ease-in-out infinite;
  }

  .glow-indigo {
    top: 120px;
    right: -200px;
    width: 720px;
    height: 720px;
    background: radial-gradient(circle, rgba(129, 140, 248, 0.2), transparent 65%);
    filter: blur(50px);
    animation: drift2 18s ease-in-out infinite;
  }

  @keyframes drift {
    0% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(40px, -30px) scale(1.08); }
    100% { transform: translate(0, 0) scale(1); }
  }

  @keyframes drift2 {
    0% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(-50px, 40px) scale(1.12); }
    100% { transform: translate(0, 0) scale(1); }
  }

  .page {
    position: relative;
    width: min(1160px, calc(100% - 48px));
    margin: 0 auto;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 28px 0;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #f1f5f9;
  }

  .logo {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 11px;
    background: linear-gradient(135deg, #38bdf8, #6366f1);
    color: #05080f;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: 16px;
    letter-spacing: -0.02em;
    box-shadow: 0 0 24px rgba(56, 189, 248, 0.4);
  }

  .wordmark {
    font-family: "Space Grotesk", sans-serif;
    font-weight: 600;
    font-size: 17px;
    letter-spacing: -0.01em;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .nav-apps {
    font-size: 15px;
    font-weight: 500;
    color: #94a3b8;
    transition: color 0.2s;
  }

  .nav-apps:hover {
    color: #e2e8f0;
  }

  .nav-contact {
    font-size: 15px;
    font-weight: 600;
    color: #05080f;
    background: #e2e8f0;
    padding: 10px 20px;
    border-radius: 999px;
    transition: background 0.2s;
  }

  .nav-contact:hover {
    background: #ffffff;
  }

  .hero {
    padding: 110px 0 90px;
    max-width: 900px;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 28px;
    padding: 8px 16px;
    border: 1px solid rgba(56, 189, 248, 0.3);
    border-radius: 999px;
    background: rgba(56, 189, 248, 0.08);
    color: #7dd3fc;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 12px;
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #38bdf8;
    box-shadow: 0 0 12px #38bdf8;
  }

  h1 {
    margin: 0;
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(46px, 7.5vw, 96px);
    line-height: 0.98;
    letter-spacing: -0.045em;
    font-weight: 700;
    color: #f8fafc;
    text-wrap: balance;
  }

  .gradient-text {
    background: linear-gradient(100deg, #38bdf8 10%, #818cf8 60%, #c084fc 95%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .subtitle {
    max-width: 600px;
    margin: 30px 0 0;
    font-size: 20px;
    line-height: 1.65;
    color: #94a3b8;
    text-wrap: pretty;
  }

  .ctas {
    display: flex;
    gap: 14px;
    margin-top: 40px;
    flex-wrap: wrap;
  }

  .arrow {
    font-family: "Space Grotesk", sans-serif;
  }

  .cta-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 15px 28px;
    border-radius: 999px;
    background: linear-gradient(120deg, #38bdf8, #60a5fa);
    color: #041018;
    font-weight: 700;
    font-size: 16px;
    box-shadow: 0 8px 32px rgba(56, 189, 248, 0.35);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .cta-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 40px rgba(56, 189, 248, 0.5);
  }

  .cta-ghost {
    display: inline-flex;
    align-items: center;
    padding: 15px 28px;
    border-radius: 999px;
    border: 1px solid rgba(148, 163, 184, 0.3);
    color: #cbd5e1;
    font-weight: 600;
    font-size: 16px;
    transition: border-color 0.2s, background 0.2s, color 0.2s;
  }

  .cta-ghost:hover {
    border-color: rgba(148, 163, 184, 0.6);
    background: rgba(148, 163, 184, 0.08);
    color: #f1f5f9;
  }

  .apps {
    padding: 20px 0 80px;
  }

  .section-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }

  .section-header h2 {
    margin: 0;
    font-family: "Space Grotesk", sans-serif;
    font-size: 40px;
    letter-spacing: -0.03em;
    color: #f8fafc;
  }

  .section-header p {
    margin: 0;
    color: #64748b;
    font-size: 16px;
  }

  .featured {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    border-radius: 32px;
    overflow: hidden;
    border: 1px solid rgba(148, 163, 184, 0.18);
    background: linear-gradient(140deg, rgba(30, 41, 59, 0.6), rgba(15, 23, 42, 0.9));
    backdrop-filter: blur(12px);
    color: inherit;
    transition: transform 0.25s, border-color 0.25s, box-shadow 0.25s;
  }

  .featured + .featured {
    margin-top: 20px;
  }

  .featured:hover {
    transform: translateY(-4px);
    border-color: rgba(var(--accent-rgb), 0.45);
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.5);
  }

  .featured-copy {
    padding: 52px 48px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 18px;
  }

  .featured-meta {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .pill-featured {
    padding: 6px 14px;
    border-radius: 999px;
    background: rgba(var(--accent-rgb), 0.12);
    border: 1px solid rgba(var(--accent-rgb), 0.35);
    color: var(--accent-from);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .platform {
    color: #64748b;
    font-size: 13px;
    font-weight: 600;
  }

  .featured-copy h3 {
    margin: 0;
    font-family: "Space Grotesk", sans-serif;
    font-size: 42px;
    letter-spacing: -0.03em;
    color: #f8fafc;
  }

  .featured-description {
    margin: 0;
    max-width: 440px;
    color: #94a3b8;
    font-size: 17px;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 4px;
  }

  .chip {
    padding: 5px 12px;
    border-radius: 999px;
    border: 1px solid rgba(148, 163, 184, 0.22);
    color: #94a3b8;
    font-size: 12.5px;
    font-weight: 600;
  }

  .chip-more {
    padding: 5px 12px;
    border-radius: 999px;
    color: #64748b;
    font-size: 12.5px;
    font-weight: 600;
  }

  .featured-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 10px;
    color: var(--accent-from);
    font-weight: 700;
    font-size: 16px;
  }

  .featured-visual {
    position: relative;
    min-height: 460px;
    background:
      radial-gradient(ellipse 120% 90% at 70% 40%, rgba(var(--accent-rgb), 0.2), transparent 65%),
      #08070d;
    overflow: hidden;
  }

  .featured-visual img {
    position: absolute;
    top: 44px;
    left: 50%;
    transform: translateX(-50%) rotate(2deg);
    width: 78%;
    border-radius: 24px;
    box-shadow: 0 32px 80px rgba(0, 0, 0, 0.7);
  }

  .placeholder {
    display: grid;
    place-items: center;
    margin-top: 20px;
    padding: 40px 32px;
    border-radius: 28px;
    border: 1px dashed rgba(148, 163, 184, 0.25);
    color: #475569;
    font-size: 15px;
    font-weight: 500;
  }

  footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    border-top: 1px solid rgba(148, 163, 184, 0.15);
    margin-top: 40px;
    padding: 32px 0 48px;
    color: #64748b;
    font-size: 14.5px;
  }

  footer p {
    margin: 0;
  }

  .footer-links {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
  }

  .footer-links a {
    color: #94a3b8;
    font-weight: 500;
    transition: color 0.2s;
  }

  .footer-links a:hover {
    color: #e2e8f0;
  }

  @media (max-width: 820px) {
    .hero {
      padding: 70px 0 60px;
    }

    .featured {
      grid-template-columns: 1fr;
    }

    .featured-copy {
      padding: 36px 28px;
    }

    .featured-visual {
      min-height: 380px;
    }
  }
</style>
