---
import { apps } from "../../../data/apps";

export function getStaticPaths() {
  return apps.map((app) => ({
    params: { slug: app.slug },
    props: { app },
  }));
}

const { app } = Astro.props;

const year = new Date().getFullYear();
const nameWords = app.name.split(" ");
const nameLead = nameWords.slice(0, -1).join(" ");
const nameAccent = nameWords[nameWords.length - 1];
const heroBack = app.screenshots[app.heroScreenshots?.[0] ?? 0];
const heroFront = app.screenshots[app.heroScreenshots?.[1] ?? 0];
const accentVars = `--accent-from: ${app.accent.from}; --accent-to: ${app.accent.to}; --accent-contrast: ${app.accent.contrast}; --accent-rgb: ${app.accent.rgb};`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{app.name} | Over Tech Apps</title>
    <meta name="description" content={app.description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <div class="scene" style={accentVars}>
      <div class="top-glow" aria-hidden="true"></div>

      <main class="page">
        <nav class="nav">
          <a class="brand" href="/">
            <span class="logo">OT</span>
            <span class="wordmark">Over Tech Apps</span>
          </a>
          <a class="back" href="/">← All apps</a>
        </nav>

        <header class="hero">
          <div class="hero-copy">
            <p class="eyebrow">iOS · {app.category}</p>
            <h1>
              {nameLead && <>{nameLead}{" "}</>}<span class="gradient-text">{nameAccent}</span>
            </h1>
            <p class="subtitle">{app.description}</p>
            <div class="ctas">
              {app.appStoreUrl ? (
                <a class="cta-primary" href={app.appStoreUrl}> View on the App Store</a>
              ) : (
                <span class="cta-primary muted">App Store link coming soon</span>
              )}
              <a class="cta-ghost" href={`mailto:${app.supportEmail}`}>Support</a>
            </div>
          </div>
          {app.screenshots.length > 1 && (
            <div class="hero-visual">
              <img class="shot-back" src={heroBack.src} alt={`${app.name} — ${heroBack.title}`} />
              <img class="shot-front" src={heroFront.src} alt={`${app.name} — ${heroFront.title}`} />
            </div>
          )}
        </header>

        {app.screenshots.length > 0 && (
          <section class="preview">
            <div class="section-header">
              <h2>Preview</h2>
              <p>Discover the main features of {app.name}.</p>
            </div>
            <div class="shots">
              {app.screenshots.map((screenshot) => (
                <figure>
                  <img src={screenshot.src} alt={`${app.name} — ${screenshot.title}`} />
                  <figcaption>
                    <strong>{screenshot.title}</strong>
                    <span>{screenshot.description}</span>
                  </figcaption>
                </figure>
              ))}
            </div>
          </section>
        )}

        {app.affiliate?.enabled && (
          <section class="brands-section">
            <div class="brands-grid">
              <div class="brands-intro">
                <h2>Marques couvertes</h2>
                <p>
                  {app.name} compare les chaussures de {app.affiliate.brands.length}
                  {" "}marques de running, sur la base de leurs caractéristiques
                  techniques et de votre profil de coureur.
                </p>
              </div>
              <div class="brands-body">
                <ul class="brands">
                  {app.affiliate.brands.map((brand) => <li>{brand}</li>)}
                </ul>
                <p class="disclosure">
                  Certains liens vers les boutiques des marques et de nos revendeurs
                  partenaires sont des liens d'affiliation, signalés par la mention
                  « Lien affilié » — sans surcoût pour vous, et sans influence sur les
                  recommandations.{" "}
                  <a href={`/apps/${app.slug}/affiliation`}>En savoir plus</a>
                </p>
              </div>
            </div>
          </section>
        )}

        <section class="links">
          <a href={`/apps/${app.slug}/privacy`}>
            Privacy Policy <span>How your data is handled</span>
          </a>
          <a href={`/apps/${app.slug}/support`}>
            Support <span>Get help with the app</span>
          </a>
          <a href={`/apps/${app.slug}/terms`}>
            Terms of Use <span>Rules of the road</span>
          </a>
          {app.affiliate?.enabled && (
            <a href={`/apps/${app.slug}/affiliation`}>
              Affiliation &amp; transparence <span>Liens affiliés expliqués</span>
            </a>
          )}
          {app.privacy.hasLogin && (
            <a href={`/apps/${app.slug}/remove-account`}>
              Delete your account <span>Remove your data anytime</span>
            </a>
          )}
        </section>

        <footer>
          <p>© {year} Over Tech Apps</p>
          <a href="mailto:overtechapps@gmail.com">overtechapps@gmail.com</a>
        </footer>
      </main>
    </div>
  </body>
</html>

<style>
  :global(html),
  :global(body) {
    margin: 0;
    padding: 0;
    background: #05080f;
  }

  :global(body) {
    font-family: "Instrument Sans", ui-sans-serif, system-ui, sans-serif;
    color: #e2e8f0;
    -webkit-font-smoothing: antialiased;
  }

  .scene ::selection {
    background: rgba(var(--accent-rgb), 0.3);
  }

  a {
    text-decoration: none;
  }

  .scene {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
  }

  .top-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      ellipse 80% 50% at 50% -10%,
      rgba(var(--accent-rgb), 0.1),
      transparent 70%
    );
  }

  .page {
    position: relative;
    width: min(1160px, calc(100% - 48px));
    margin: 0 auto;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 28px 0;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #f1f5f9;
  }

  .logo {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 11px;
    background: linear-gradient(135deg, #38bdf8, #6366f1);
    color: #05080f;
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: 16px;
    box-shadow: 0 0 24px rgba(56, 189, 248, 0.4);
  }

  .wordmark {
    font-family: "Space Grotesk", sans-serif;
    font-weight: 600;
    font-size: 17px;
  }

  .back {
    font-size: 15px;
    font-weight: 600;
    color: #94a3b8;
    transition: color 0.2s;
  }

  .back:hover {
    color: #e2e8f0;
  }

  .hero {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 48px;
    align-items: center;
    padding: 60px 0 70px;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .eyebrow {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 10px;
    margin: 0;
    padding: 8px 16px;
    border: 1px solid rgba(var(--accent-rgb), 0.35);
    border-radius: 999px;
    background: rgba(var(--accent-rgb), 0.08);
    color: var(--accent-from);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 12px;
  }

  h1 {
    margin: 0;
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(48px, 7vw, 88px);
    line-height: 0.98;
    letter-spacing: -0.045em;
    font-weight: 700;
    color: #f8fafc;
  }

  .gradient-text {
    background: linear-gradient(100deg, var(--accent-from), var(--accent-to));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .subtitle {
    max-width: 560px;
    margin: 0;
    font-size: 19px;
    line-height: 1.65;
    color: #94a3b8;
    text-wrap: pretty;
  }

  .ctas {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 8px;
  }

  .cta-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 15px 28px;
    border-radius: 999px;
    background: linear-gradient(120deg, var(--accent-from), var(--accent-to));
    color: var(--accent-contrast);
    font-weight: 700;
    font-size: 16px;
    box-shadow: 0 8px 32px rgba(var(--accent-rgb), 0.3);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .cta-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 40px rgba(var(--accent-rgb), 0.45);
  }

  .cta-primary.muted {
    background: rgba(148, 163, 184, 0.2);
    color: #cbd5e1;
    box-shadow: none;
  }

  .cta-ghost {
    display: inline-flex;
    align-items: center;
    padding: 15px 28px;
    border-radius: 999px;
    border: 1px solid rgba(148, 163, 184, 0.3);
    color: #cbd5e1;
    font-weight: 600;
    font-size: 16px;
    transition: border-color 0.2s, background 0.2s, color 0.2s;
  }

  .cta-ghost:hover {
    border-color: rgba(148, 163, 184, 0.6);
    background: rgba(148, 163, 184, 0.08);
    color: #f1f5f9;
  }

  .hero-visual {
    position: relative;
    min-height: 480px;
    aspect-ratio: 4 / 5;
  }

  .hero-visual img {
    position: absolute;
    border-radius: 22px;
    display: block;
  }

  .shot-back {
    top: 30px;
    left: 6%;
    width: 52%;
    transform: rotate(-5deg);
    box-shadow: 0 32px 80px rgba(0, 0, 0, 0.7);
    border: 1px solid rgba(148, 163, 184, 0.15);
  }

  .shot-front {
    top: 0;
    right: 4%;
    width: 56%;
    transform: rotate(4deg);
    box-shadow: 0 40px 90px rgba(0, 0, 0, 0.8);
    border: 1px solid rgba(var(--accent-rgb), 0.2);
  }

  .section-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 28px;
    flex-wrap: wrap;
  }

  h2 {
    margin: 0;
    font-family: "Space Grotesk", sans-serif;
    font-size: 36px;
    letter-spacing: -0.03em;
    color: #f8fafc;
  }

  .section-header p {
    margin: 0;
    color: #64748b;
    font-size: 16px;
  }

  .preview {
    padding: 40px 0 60px;
    border-top: 1px solid rgba(148, 163, 184, 0.14);
  }

  .shots {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    padding-bottom: 16px;
    scroll-snap-type: x mandatory;
  }

  .shots::-webkit-scrollbar {
    height: 8px;
  }

  .shots::-webkit-scrollbar-thumb {
    background: rgba(148, 163, 184, 0.25);
    border-radius: 999px;
  }

  .shots::-webkit-scrollbar-track {
    background: transparent;
  }

  .shots figure {
    flex: 0 0 300px;
    margin: 0;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .shots img {
    width: 100%;
    border-radius: 26px;
    border: 1px solid rgba(148, 163, 184, 0.15);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
    display: block;
  }

  .shots figcaption {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 0 6px;
  }

  .shots strong {
    font-family: "Space Grotesk", sans-serif;
    font-size: 17px;
    color: #f1f5f9;
    letter-spacing: -0.01em;
  }

  .shots span {
    color: #94a3b8;
    font-size: 14.5px;
    line-height: 1.5;
  }

  .brands-section {
    padding: 48px 0;
    border-top: 1px solid rgba(148, 163, 184, 0.14);
  }

  .brands-grid {
    display: grid;
    grid-template-columns: minmax(260px, 380px) 1fr;
    gap: 48px;
    align-items: start;
  }

  .brands-intro {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .brands-intro p {
    margin: 0;
    color: #94a3b8;
    font-size: 16px;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .brands-body {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .brands {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .brands li {
    border: 1px solid rgba(148, 163, 184, 0.25);
    background: rgba(15, 23, 42, 0.6);
    border-radius: 999px;
    padding: 8px 18px;
    font-size: 14.5px;
    font-weight: 600;
    color: #cbd5e1;
    transition: border-color 0.2s, color 0.2s;
  }

  .brands li:hover {
    border-color: rgba(var(--accent-rgb), 0.5);
    color: var(--accent-from);
  }

  .disclosure {
    max-width: 680px;
    margin: 0;
    font-size: 14px;
    line-height: 1.65;
    color: #64748b;
    text-wrap: pretty;
  }

  .disclosure a {
    color: #7dd3fc;
  }

  .disclosure a:hover {
    color: #bae6fd;
  }

  .links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 14px;
    padding: 40px 0 60px;
    border-top: 1px solid rgba(148, 163, 184, 0.14);
  }

  .links a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 22px 24px;
    border-radius: 20px;
    border: 1px solid rgba(148, 163, 184, 0.18);
    background: rgba(15, 23, 42, 0.5);
    color: #e2e8f0;
    font-weight: 600;
    font-size: 15.5px;
    transition: border-color 0.2s, transform 0.2s, color 0.2s;
  }

  .links a:hover {
    border-color: rgba(56, 189, 248, 0.5);
    transform: translateY(-2px);
    color: #f1f5f9;
  }

  .links span {
    color: #64748b;
    font-weight: 400;
    font-size: 13.5px;
  }

  footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    border-top: 1px solid rgba(148, 163, 184, 0.15);
    padding: 32px 0 48px;
    color: #64748b;
    font-size: 14.5px;
  }

  footer p {
    margin: 0;
  }

  footer a {
    color: #94a3b8;
    font-weight: 500;
    transition: color 0.2s;
  }

  footer a:hover {
    color: #e2e8f0;
  }

  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
      padding: 40px 0 50px;
    }

    .hero-visual {
      min-height: 0;
      height: 420px;
    }

    .brands-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
