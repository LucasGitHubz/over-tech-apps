---
import { apps } from "../../../data/apps";

export function getStaticPaths() {
  return apps
    .filter((app) => app.privacy.hasLogin)
    .map((app) => ({
      params: { slug: app.slug },
      props: { app },
    }));
}

const { app } = Astro.props;
const deletionSubject = encodeURIComponent(`${app.name} account deletion request`);
const deletionEmailUrl = `mailto:${app.supportEmail}?subject=${deletionSubject}`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Delete your account | {app.name}</title>
    <meta
      name="description"
      content={`How to request deletion of your ${app.name} account and associated data.`}
    />
  </head>

  <body>
    <main class="page">
      <a href={`/apps/${app.slug}`}>← Back to {app.name}</a>

      <header>
        <p class="eyebrow">Account and data deletion</p>
        <h1>Delete your {app.name} account</h1>
        <p class="intro">
          You can permanently delete your account and the personal data associated with it
          either from the app or by contacting Over Tech Apps.
        </p>
      </header>

      <section class="card">
        <p class="step">Option 1</p>
        <h2>Delete your account in the app</h2>
        <ol>
          <li>Open {app.name} and sign in to your account.</li>
          <li>Open the <strong>Profile</strong> tab.</li>
          <li>Select <strong>Delete account</strong>.</li>
          <li>Confirm the deletion.</li>
        </ol>
        <p>
          For security, the app may ask you to sign in again before completing the request.
          In-app deletion is processed immediately after confirmation.
        </p>
      </section>

      <section class="card">
        <p class="step">Option 2</p>
        <h2>Request deletion without the app</h2>
        <p>
          Email Over Tech Apps from the address linked to your account. Include the app name
          and clearly state that you want your account and associated data deleted.
        </p>
        <a class="button" href={deletionEmailUrl}>Request account deletion</a>
        <p class="detail">
          Email: <a href={`mailto:${app.supportEmail}`}>{app.supportEmail}</a><br />
          Requests submitted by email are processed within 30 days after account ownership
          has been verified.
        </p>
      </section>

      <section>
        <h2>Data that will be deleted</h2>
        <ul>
          <li>Your authentication account and user identifier.</li>
          <li>Your email address and profile name.</li>
          <li>Your runner profile and preferences, including shoe size, terrain, and language.</li>
          <li>Your saved favorite shoes.</li>
          <li>Your saved questionnaire answers and latest recommendation results.</li>
        </ul>
      </section>

      <section>
        <h2>Data that may be retained</h2>
        <p>
          Aggregated or de-identified analytics and aggregate shoe popularity counts that
          cannot be linked back to your deleted account may be retained. Information may also
          be retained when required for security, fraud prevention, or legal compliance.
        </p>
      </section>

      <section>
        <h2>Need help?</h2>
        <p>
          Contact <a href={`mailto:${app.supportEmail}`}>{app.supportEmail}</a> for questions
          about account or data deletion.
        </p>
        <p><a href={`/apps/${app.slug}/privacy`}>Read the Privacy Policy</a></p>
      </section>
    </main>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
    background: #0f172a;
    color: #e5e7eb;
  }

  .page {
    width: min(820px, calc(100% - 40px));
    margin: 0 auto;
    padding: 48px 0 72px;
  }

  header {
    padding: 56px 0 24px;
  }

  .eyebrow,
  .step {
    color: #38bdf8;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 760px;
    margin: 8px 0 16px;
    font-size: clamp(42px, 7vw, 72px);
    line-height: 1;
    letter-spacing: -0.05em;
  }

  h2 {
    margin-top: 40px;
  }

  .card h2 {
    margin-top: 0;
  }

  p,
  li {
    color: #cbd5e1;
    line-height: 1.7;
  }

  .intro {
    max-width: 680px;
    font-size: 20px;
  }

  .card {
    margin-top: 24px;
    padding: 24px;
    border: 1px solid rgba(148, 163, 184, 0.25);
    border-radius: 24px;
    background: rgba(15, 23, 42, 0.75);
  }

  .step {
    margin: 0 0 8px;
  }

  .button {
    display: inline-flex;
    margin: 8px 0;
    padding: 14px 20px;
    border-radius: 999px;
    background: #38bdf8;
    color: #020617;
    text-decoration: none;
  }

  .detail {
    margin-bottom: 0;
  }

  a {
    color: #38bdf8;
    font-weight: 700;
  }

  strong {
    color: #f8fafc;
  }
</style>
